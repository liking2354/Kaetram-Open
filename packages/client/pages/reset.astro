---
import DefaultLayout from '../layouts/default.astro';

import '../scss/main.scss';
import { t } from '@kaetram/common/i18n';
---

<script src="../src/reset.ts"></script>

<DefaultLayout title={t('misc:UI_RESET_PASSWORD')}>
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="reset-password">
                <h1 class="title-decoration">{t('misc:UI_RESET_PASSWORD')}</h1>

                <form onsubmit={'return false'}>
                    <input
                        type="password"
                        id="password-input"
                        class="stroke slice-input"
                        name="player-password"
                        placeholder={t('misc:UI_PASSWORD')}
                        aria-label={t('misc:UI_PASSWORD')}
                        maxlength="64"
                        autocomplete="off"
                    />
                    <input
                        type="password"
                        id="password-confirm-input"
                        class="stroke slice-input"
                        name="player-password"
                        placeholder={t('misc:UI_CONFIRM_PASSWORD')}
                        aria-label={t('misc:UI_CONFIRM_PASSWORD')}
                        maxlength="64"
                        autocomplete="off"
                    />

                    <div class="validation-summary"></div>

                    <div>
                        <button
                            title={t('misc:UI_ACCEPT_RESET')}
                            aria-label={t('misc:UI_ACCEPT_RESET')}
                            type="button"
                            id="confirm-reset"
                            class="stroke slice-button"
                        >
                            {t('misc:UI_ACCEPT')}
                        </button>
                    </div>
                </form>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #reset-password {
        pointer-events: auto;
        opacity: 1;
    }
</style>
