---
import DefaultLayout from '../layouts/default.astro';

import '../scss/main.scss';
import { t } from '@kaetram/common/i18n';
---

<DefaultLayout title={t('misc:UI_ABOUT')}>
    <div id="intro">
        <section id="parchment" class="slice-menu">
            <article id="unavailable-screen">
                <h1 class="title-decoration">{t('game:NAME')}</h1>

                <p>
                    {t('misc:UI_UNAVAILABLE_TEXT')}
                    <a target="_blank" href="https://discord.gg/MmbGAaw"
                        >{t('misc:UI_DISCORD_SERVER')}</a
                    >.
                </p>
            </article>
        </section>
    </div>
</DefaultLayout>

<style is:global>
    #unavailable-screen {
        pointer-events: auto;
        opacity: 1;

        p {
            margin-top: 3em;
        }
    }
</style>
