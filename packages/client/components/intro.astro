---
import { t, getLanguage } from '@kaetram/common/i18n';

let currentLanguage = getLanguage(),
    languages = [
        { locale: 'en', name: 'English' },
        { locale: 'zh', name: '简体中文' }
    ];
---

<div id="intro">
    <section id="parchment" class="load-character slice-menu-fancy">
        <article id="load-character">
            <h1 class="title-decoration">{t('game:NAME')}</h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="login-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder={t('misc:UI_USERNAME')}
                    aria-label={t('misc:UI_USERNAME')}
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="login-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder={t('misc:UI_PASSWORD')}
                    aria-label={t('misc:UI_PASSWORD')}
                    maxlength="64"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <label id="remember-me" class="check">
                        <input type="checkbox" aria-labelledby="remember-me-text" />
                        <span class="checkmark"></span>

                        <span id="remember-me-text">{t('misc:UI_REMEMBER_ME')}</span>
                    </label>
                    <label id="guest" class="check">
                        <input type="checkbox" aria-labelledby="guest-text" />
                        <span class="checkmark"></span>

                        <span id="guest-text">{t('misc:UI_PLAY_AS_GUEST')}</span>
                    </label>
                </div>

                <div class="button-row">
                    <button
                        title={t('misc:UI_LOGIN')}
                        aria-label={t('misc:UI_LOGIN')}
                        type="submit"
                        id="login"
                        class="stroke slice-button"
                        disabled
                    >
                        {t('misc:UI_LOGIN')}
                    </button>
                    <button
                        title={t('misc:UI_NEW_ACCOUNT')}
                        aria-label={t('misc:UI_NEW_ACCOUNT')}
                        type="button"
                        id="new-account"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_NEW_ACCOUNT')}
                    </button>
                </div>
            </form>
        </article>

        <article id="create-character">
            <h1 class="title-decoration">{t('misc:UI_NEW_CHARACTER')}</h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="register-name-input"
                    class="stroke slice-input"
                    name="player-name"
                    placeholder={t('misc:UI_USERNAME')}
                    aria-label={t('misc:UI_USERNAME')}
                    maxlength="32"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-input"
                    class="stroke slice-input"
                    name="player-password"
                    placeholder={t('misc:UI_PASSWORD')}
                    aria-label={t('misc:UI_PASSWORD')}
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="password"
                    id="register-password-confirmation-input"
                    class="stroke slice-input"
                    name="player-password2"
                    placeholder={t('misc:UI_CONFIRM_PASSWORD')}
                    aria-label={t('misc:UI_CONFIRM_PASSWORD')}
                    maxlength="64"
                    autocomplete="off"
                />
                <input
                    type="email"
                    id="register-email-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder={t('misc:UI_EMAIL')}
                    aria-label={t('misc:UI_EMAIL')}
                    maxlength="64"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title={t('misc:UI_CANCEL')}
                        aria-label={t('misc:UI_CANCEL')}
                        type="button"
                        id="cancel-register"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_CANCEL')}
                    </button>
                    <button
                        title={t('misc:UI_PLAY')}
                        aria-label={t('misc:UI_PLAY')}
                        type="submit"
                        id="play"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_PLAY')}
                    </button>
                </div>
            </form>
        </article>

        <article id="reset-password">
            <h1>
                <span class="left-ornament"></span>
                 {t('misc:UI_RESET_PASSWORD')}
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <input
                    type="text"
                    id="email-reset-input"
                    class="stroke slice-input"
                    name="player-email"
                    placeholder={t('misc:UI_EMAIL')}
                    aria-label={t('misc:UI_EMAIL')}
                    maxlength="32"
                    autocomplete="off"
                />

                <div class="validation-summary"></div>

                <div class="button-row">
                    <button
                        title={t('misc:UI_CANCEL')}
                        aria-label={t('misc:UI_CANCEL')}
                        type="button"
                        id="cancel-forget"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_CANCEL')}
                    </button>
                    <button
                        title={t('misc:UI_CONTINUE')}
                        aria-label={t('misc:UI_CONTINUE')}
                        type="submit"
                        id="continue-forget"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_CONTINUE')}
                    </button>
                </div>
            </form>
        </article>

        <article id="world-select">
            <h1>
                <span class="left-ornament"></span>
                 {t('misc:UI_WORLD_SELECT')}
                <span class="right-ornament"></span>
            </h1>

            <form onsubmit={'return false'}>
                <ol id="worlds"></ol>

                <div class="button-row">
                    <button
                        title={t('misc:UI_CANCEL')}
                        aria-label={t('misc:UI_CANCEL')}
                        type="button"
                        id="cancel-worlds"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_CANCEL')}
                    </button>
                    <button
                        title={t('misc:UI_CONTINUE')}
                        aria-label={t('misc:UI_CONTINUE')}
                        type="submit"
                        id="continue-worlds"
                        class="stroke slice-button"
                    >
                        {t('misc:UI_CONTINUE')}
                    </button>
                </div>
            </form>
        </article>

        <article id="credits">
            <h1 class="title-decoration">{t('misc:UI_CREDITS')}</h1>

            <p>
                <br />
                 {t('misc:UI_CREDITS_THANKS')}
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.littleworkshop.fr/">Little Workshop</a
                >
                 {t('misc:UI_CREDITS_PIXEL')}
                <br />
                <br />
                 {t('misc:UI_CREDITS_AND_TEAM')}
                <br />
                <br />
                 {t('misc:UI_CREDITS_MORE_ASSETS')}
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/users/buch">Buch</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://shikashiassets.itch.io/shikashis-fantasy-icons-pack">Shikashi</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://opengameart.org/content/kyrises-free-16x16-rpg-icon-pack"
                    >Kyrise</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://game-icons.net">Game-Icons.net</a
                >, &amp; Boo
                <br />
                <br />
                 {t('misc:UI_CREDITS_MUSIC')}
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://soundcloud.com/gyrowolf">Terrel O'Brien</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://blog.dayjo.org">Joel Day</a
                >,
                <a
                    rel="noopener noreferrer"
                    class="clickable"
                    target="_blank"
                    href="https://www.dantilden.com">Dan Tilden</a
                >, &amp;
                <a
                    rel="noopener noreferrer"
                    target="_blank"
                    class="clickable"
                    href="https://soundcloud.com/aaron-anderson-11">Aaron Krogh</a
                >
            </p>

            <div class="close-about">
                <span>{t('misc:UI_CLICK_TO_CLOSE')}</span>
            </div>
        </article>

        <article id="about">
            <h1 class="title-decoration">{t('misc:UI_ABOUT')}</h1>

            <p>
                {t('misc:UI_ABOUT_TEXT')}
                <a target="_blank" href="https://github.com/Kaetram/Kaetram-Open"
                    >GitHub Repository</a
                >. If you would like to stay up-to-date with the project, make sure you join our
                <a target="_blank" href="https://discord.gg/MmbGAaw">Discord server</a>.
            </p>

            <div class="close-about">
                <span>{t('misc:UI_CLICK_TO_CLOSE')}</span>
            </div>
        </article>

        <article id="git">Structure this later</article>

        <article id="death">
            <h1>{t('misc:UI_YOU_HAVE_DIED')}</h1>
            <button
                title={t('misc:UI_RESPAWN')}
                id="respawn"
                aria-label={t('misc:UI_RESPAWN')}
                class="stroke slice-button">{t('misc:UI_RESPAWN')}</button
            >
        </article>

        <span class="loader" hidden>
            {t('misc:UI_CONNECTING')}<span class="loader-dot">.</span><span class="loader-dot">.</span><span
                class="loader-dot">.</span
            >
        </span>
    </section>

    <select id="lang-select" oninput={'location = "/" + this.value + "/"'}>
        {
            languages.map(({ locale, name }) => (
                <option value={locale} selected={locale === currentLanguage}>
                    {name}
                </option>
            ))
        }
    </select>

    <button id="world-select-button" class="slice-button" hidden>
        <strong class="stroke"></strong>
        <span class="stroke"></span>
    </button>

    <span id="game-version" class="version"></span>

    <footer>
        <div id="about-link" class="clickable">
            <span id="toggle-about">{t('misc:UI_ABOUT')}</span>
        </div>
        <span>&ndash;</span>
        <div id="credits-link" class="clickable">
            <span id="toggle-credits">{t('misc:UI_CREDITS')}</span>
        </div>
        <span>&ndash;</span>
        <div id="discord-link" class="clickable">
            <a class="footer-button" target="_blank" href="https://discord.gg/MmbGAaw">
                <span>{t('misc:UI_DISCORD')}</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div class="clickable">
            <a
                class="footer-button"
                target="_blank"
                href="https://www.patreon.com/bePatron?u=29287394"
            >
                <span>{t('misc:UI_PATREON')}</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div id="privacy" class="clickable">
            <a class="footer-button" href="/privacy/">
                <span>{t('misc:UI_PRIVACY')}</span>
            </a>
        </div>
        <span>&ndash;</span>
        <div id="reset" class="clickable">
            <span id="toggle-reset-password">{t('misc:UI_RESET_PASSWORD')}</span>
        </div>
    </footer>
</div>
