; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kaetram Godot Client"
config/description="Godot 4.7 client for Kaetram-Open MMORPG server."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Network="*res://scripts/network/network_manager.gd"
GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio_manager.gd"
I18n="*res://scripts/i18n.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=true
